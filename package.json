{
  "name": "sefaria-lens",
  "productName": "Sefaria Lens",
  "version": "1.0.11",
  "description": "Sefaria reader with sourced Q&A, transliteration in seven traditions, and word-by-word study tools",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node tools/devserver.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win portable --x64 --publish never",
    "freebuff-fifo": "node tools/freebuff-fifo.js",
    "release": "node tools/release.js"
  },
  "author": "Sefaria Lens contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "org.sefaria.lens",
    "productName": "Sefaria Lens",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SefariaLens-${version}-portable.exe",
      "requestExecutionLevel": "user"
    }
  }
}
